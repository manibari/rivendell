  "cards": [
    {
      "dot": "emerald",
      "title": "收斂的（照抄）",
      "items": [
        "auth crypto core：jose + bcrypt + HS256，sub 永遠是 str(user_id)",
        "schema-sync：Alembic，deploy 在 serve 前跑 upgrade head",
        "versioning：閘門是核心，不是 changelog 格式"
      ]
    },
    {
      "dot": "amber",
      "title": "每個產品要自己決定的",
      "items": [
        "token：單一長效 vs access + refresh",
        "rbac：Tier-1 寫死 vs Tier-2 Role×Entity 矩陣",
        "changelog：dev-facing vs 使用者看的更新歷程"
      ]
    },
