.DS_Store
*.swp
*~
# ** so the archive counts too: sk-reports-janitor moves -error.log siblings
# into reports/archive/YYYY-MM/, and a single-level glob stops matching there.
reports/**/*.log
reports/maintain-*

# Agent runtime state — regenerated by agents, noisy in git status.
# .harvest-decisions.json is intentionally NOT ignored — it holds user accept/dismiss decisions.
reports/.watchdog-state
reports/.harvest-state
reports/.harvest-done
scripts/__pycache__/
apps/dashboard-legacy/data/*.db
# SQLite sidecars (-wal/-shm) and retired/backup copies: the bare *.db
# pattern misses them, and a retired store is still a store.
apps/dashboard-legacy/data/*.db-*
apps/dashboard-legacy/data/*.db.*
apps/dashboard-legacy/data/*.db-wal
apps/dashboard-legacy/data/*.db-shm
data/*.db
data/*.db-wal
data/*.db-shm
__pycache__/
logs/
data/cost-ledger.jsonl
apps/dashboard-api/.venv/
node_modules/

# Deploy system
.active-profile
.env
.env.shared
.gstack/

# Disk usage snapshot (regenerated daily by sk-disk-snapshot)
apps/dashboard-legacy/data/disk-tree.json
apps/dashboard-web/public/avatar/models/*.vrm
apps/avatar-gateway/.venv/

# Generated by sk-registry-gen from agents/registry/ (registry is the SoT)
platform/agent_fleet/agents.conf

# sk-sensors helper, built on demand from platform/monitoring/system/sensors.c
platform/monitoring/system/build/
