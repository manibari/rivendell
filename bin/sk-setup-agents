#!/usr/bin/env bash
# Bootstrap script — generates and loads service units from agents.conf.
# Run once on a new machine (or after changing agents.conf):
#   ./bin/sk-setup-agents
#
# What it does:
#   1. Compiles sk-agent-run binary (macOS only — see below)
#   2. Detects python3/conda/npm paths → builds PATH
#   3. Reads agents/agents.conf → generates a unit per agent via svc_generate_raw
#      (launchd plist on macOS, systemd .service/.timer on Linux/WSL)
#   4. Loads them through svc_load
#
# Options:
#   --dry-run   Print generated units without installing
#   --unload    Unload all managed agents
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$REPO_DIR/bin/lib/platform.sh"
SK_PLATFORM="$(sk_platform)"

if ! svc_supported; then
  echo "Cannot manage agents on this host: $(svc_unsupported_reason)" >&2
  exit 1
fi

CONF="$REPO_DIR/agents/agents.conf"
SK_AGENT_RUN="$HOME/.local/bin/sk-agent-run"
# Derive from REPO_DIR's parent (all project repos are siblings of rivendell),
# NOT a hardcoded path. Hardcoding "$HOME/Documents/Projects" broke after the
# iCloud-detach move to ~/code: rerunning regenerated every plist pointing at
# the dead old path. Override with SK_PROJECTS_DIR if repos live elsewhere.
PROJECTS_DIR="${SK_PROJECTS_DIR:-$(dirname "$REPO_DIR")}"
SELF_NAME="$(basename "$REPO_DIR")"
DRY_RUN=false
UNLOAD_ONLY=false

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --unload) UNLOAD_ONLY=true ;;
  esac
done

# ─── Detect PATH components ───
detect_path() {
  local parts="/usr/local/bin:/usr/bin:/bin"

  # Homebrew (macOS only; on Linux this dir simply won't exist)
  if [ -d "/opt/homebrew/bin" ]; then
    parts="/opt/homebrew/bin:$parts"
  fi

  # Conda (search common locations)
  for conda_bin in \
    "$HOME/miniconda3/bin" \
    "$HOME/anaconda3/bin" \
    "/opt/homebrew/Caskroom/miniconda/base/bin" \
    "$HOME/.conda/bin"; do
    if [ -d "$conda_bin" ]; then
      parts="$conda_bin:$parts"
      break
    fi
  done

  # npm global
  local npm_bin
  npm_bin="$(npm config get prefix 2>/dev/null)/bin" || true
  if [ -d "$npm_bin" ]; then
    parts="$parts:$npm_bin"
  fi

  # ~/.local/bin
  parts="$parts:$HOME/.local/bin"

  echo "$parts"
}

AGENT_PATH="$(detect_path)"
# Consumed by svc_generate_raw when it writes the unit's PATH.
export SK_AGENT_PATH="$AGENT_PATH"
export SK_AGENT_RUN
echo "Platform: $SK_PLATFORM"
echo "Detected PATH: $AGENT_PATH"
echo ""

# ─── Compile & install sk-agent-run ───
# macOS only. The binary exists purely to setenv REPO_DIR and chdir before
# exec'ing bash, because launchd runs outside the TCC grant and getcwd() fails
# there. systemd expresses both natively (WorkingDirectory=/Environment=), so on
# Linux the wrapper would add a compiled C dependency and buy nothing.
if [ "$SK_PLATFORM" = "darwin" ] && ! $DRY_RUN && ! $UNLOAD_ONLY; then
  echo "Compiling sk-agent-run..."
  mkdir -p "$(dirname "$SK_AGENT_RUN")"
  cc -O2 -o "$SK_AGENT_RUN" "$REPO_DIR/agents/sk-agent-run.c"
  echo "Installed: $SK_AGENT_RUN"
  echo ""
fi

# ─── Unload mode ───
if $UNLOAD_ONLY; then
  echo "Unloading all managed agents..."
  while IFS='|' read -r label _rest; do
    label="$(echo "$label" | xargs)"
    [ -z "$label" ] && continue
    if svc_is_loaded "$label"; then
      svc_unload "$label" && echo "  Unloaded: $label" || true
    fi
  done < <(grep -v '^\s*#' "$CONF" | grep -v '^\s*$')
  exit 0
fi

DRY_DIR=""
if $DRY_RUN; then
  DRY_DIR="$(mktemp -d)"
  trap 'rm -rf "$DRY_DIR"' EXIT
fi

# ─── Generate units ───
# PROJECTS_DIR: derive from REPO_DIR's parent (all project repos are siblings of
# rivendell), NOT a hardcoded path. Hardcoding "$HOME/Documents/Projects" broke
# after the iCloud-detach move to ~/code: rerunning regenerated every unit
# pointing at the dead old path. Override with SK_PROJECTS_DIR.
while IFS='|' read -r label project_rel script sched_type sched_val log_dir_rel extra_args; do
  label="$(echo "$label" | xargs)"
  project_rel="$(echo "$project_rel" | xargs)"
  script="$(echo "$script" | xargs)"
  sched_type="$(echo "$sched_type" | xargs)"
  sched_val="$(echo "$sched_val" | xargs)"
  extra_args="$(echo "${extra_args:-}" | xargs)"
  [ -z "$label" ] && continue

  # "." (and this repo's own name) mean rivendell itself; anything else is a
  # sibling repo. Derived, never hardcoded — a rename must not break this.
  if [ "$project_rel" = "." ] || [ "$project_rel" = "$SELF_NAME" ]; then
    project_dir="$REPO_DIR"
  else
    project_dir="$PROJECTS_DIR/$project_rel"
  fi

  if $DRY_RUN; then
    echo "=== $label ($sched_type) ==="
    # Render into a scratch dir so a dry run never touches the live unit dir.
    unit="$(SK_SVC_DIR="$DRY_DIR" svc_generate_raw "$label" "$project_dir" "$script" "$sched_type" "$sched_val" "$extra_args")"
    cat "$unit"
    [ -f "${unit%.service}.timer" ] && cat "${unit%.service}.timer"
    echo
  else
    svc_unload "$label" 2>/dev/null || true
    svc_generate_raw "$label" "$project_dir" "$script" "$sched_type" "$sched_val" "$extra_args" >/dev/null
    if svc_load "$label"; then
      echo "Loaded: $label"
    else
      echo "FAILED: $label"
    fi
  fi
done < <(grep -v '^\s*#' "$CONF" | grep -v '^\s*$')

if ! $DRY_RUN; then
  # Without linger, systemd --user tears down every unit at logout — which on
  # WSL is every time the last shell closes. No-op on macOS.
  svc_boot_persist || true
  echo ""
  echo "Done. Verify with: bin/sk agent list"
fi
