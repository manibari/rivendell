#!/usr/bin/env python3
"""Generate / validate / drift-check the agent registry.

Registry is the only committed SoT (agents/registry/<name>.md). agents.conf is
a build artifact, not committed. sk-setup-agents calls `generate` at run time.

Usage:
    sk-registry-gen generate            # emit agents.conf lines to stdout (enabled agents only)
    sk-registry-gen validate            # validate every registry file; exit 1 on any FAIL
    sk-registry-gen check <conf>        # behavior-diff registry vs an existing conf; exit 1 on drift

Exit codes: 0 = ok, 1 = FAIL / drift, 2 = usage error.
"""

from __future__ import annotations

import sys
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parent.parent
# lib.registry lives under dashboard/ (same layout dashboard-next/api/server.py uses).
sys.path.insert(0, str(REPO_DIR / "dashboard"))

from lib import registry  # noqa: E402

REGISTRY_DIR = REPO_DIR / "agents" / "registry"
GENERATED_HEADER = (
    "# GENERATED by sk-registry-gen from agents/registry/ — DO NOT EDIT, DO NOT COMMIT.\n"
    "# Edit the registry markdown files instead. This file is a build artifact.\n"
)


def _known_skills() -> set[str]:
    """Skill names installed under ~/.claude/skills/ (built-ins live elsewhere → exempt)."""
    skills_dir = Path.home() / ".claude" / "skills"
    if not skills_dir.is_dir():
        return set()
    return {p.name for p in skills_dir.iterdir() if p.is_dir() or p.is_symlink()}


def _load_or_die() -> list[registry.RegistryAgent]:
    """Parse the registry dir; a malformed file is a hard FAIL (fail-fast, no half output)."""
    try:
        return registry.load_registry_dir(REGISTRY_DIR)
    except (ValueError, OSError) as e:
        print(f"[FAIL] cannot parse registry: {e}", file=sys.stderr)
        sys.exit(1)


def _validate_all(agents: list[registry.RegistryAgent]) -> list[registry.Finding]:
    known = _known_skills()
    findings: list[registry.Finding] = []
    for a in agents:
        findings.extend(registry.validate(a, known_skills=known))
    findings.extend(registry.check_label_collisions(agents))
    return findings


def cmd_validate() -> int:
    agents = _load_or_die()
    findings = _validate_all(agents)
    for f in findings:
        stream = sys.stderr if f.level == "FAIL" else sys.stdout
        print(str(f), file=stream)
    fails = [f for f in findings if f.level == "FAIL"]
    print(
        f"validated {len(agents)} agent(s): "
        f"{len(fails)} FAIL, {len(findings) - len(fails)} WARN",
        file=sys.stderr,
    )
    return 1 if fails else 0


def cmd_generate() -> int:
    agents = _load_or_die()
    fails = [f for f in _validate_all(agents) if f.level == "FAIL"]
    if fails:
        print("[FAIL] refusing to generate — validation errors:", file=sys.stderr)
        for f in fails:
            print(f"  {f}", file=sys.stderr)
        return 1
    sys.stdout.write(GENERATED_HEADER)
    for a in agents:
        if not a.enabled:
            continue  # disabled = not scheduled (also skips inert ooda ministers)
        sys.stdout.write(a.to_conf_line() + "\n")
    return 0


def _parse_conf(path: Path) -> set[tuple[str, ...]]:
    """Parse an existing agents.conf into a set of normalized 7-field tuples."""
    tuples: set[tuple[str, ...]] = set()
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        fields = [c.strip() for c in line.split("|")]
        fields += [""] * (7 - len(fields))  # pad to 7 (bash tolerates 6-field lines)
        tuples.add(tuple(fields[:7]))
    return tuples


def cmd_check(conf_path: str) -> int:
    """Behavior-diff: the enabled registry vs an existing conf. Tuples, not text."""
    agents = _load_or_die()
    fails = [f for f in _validate_all(agents) if f.level == "FAIL"]
    if fails:
        print("[FAIL] drift check aborted — registry has validation errors.", file=sys.stderr)
        return 1
    reg = {a.to_conf_tuple() for a in agents if a.enabled}
    old = _parse_conf(Path(conf_path))
    only_reg = reg - old
    only_old = old - reg
    if not only_reg and not only_old:
        print("no drift — registry generates the current conf exactly.", file=sys.stderr)
        return 0
    print("[DRIFT] registry and conf disagree:", file=sys.stderr)
    for t in sorted(only_old):
        print(f"  only in conf:     {' | '.join(t)}", file=sys.stderr)
    for t in sorted(only_reg):
        print(f"  only in registry: {' | '.join(t)}", file=sys.stderr)
    return 1


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    cmd = argv[1]
    if cmd == "generate":
        return cmd_generate()
    if cmd == "validate":
        return cmd_validate()
    if cmd == "check":
        if len(argv) < 3:
            print("usage: sk-registry-gen check <conf-path>", file=sys.stderr)
            return 2
        return cmd_check(argv[2])
    print(f"unknown command: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
